// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    // Apple silicon and Intel Macs, so the universal desktop build has an engine for both
    binaryTargets = ["native", "darwin-arm64", "darwin"]
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model User {
    id            String         @id @default(uuid())
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    username      String         @unique
    passwordHash  String
    openAiApiKey  String?
    openAiBaseUrl String?
    openAiModel   String?
    // Saved settings of every AI provider used, JSON keyed by base URL: { apiKey?, model }
    aiProviders   String         @default("{}")
    // What the AI assistant may do with queries that change data: "read_only", "ask" or "auto"
    aiWriteMode   String         @default("ask")
    connections   DbConnection[] @relation(name: "DbConnectionToUser")
    chatSessions  ChatSession[]
    chatMemories  ChatMemory[]
    queryHistory  QueryHistory[]
    savedQueries  SavedQuery[]
}

model ChatSession {
    id           String   @id @default(uuid())
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    title        String
    database     String
    // JSON array of chat completion messages, tool results also keep what the UI shows
    messages     String   @default("[]")
    connectionId String
    userId       String
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, connectionId])
}

// Notes the assistant keeps about a database, they are added to every chat on that database
model ChatMemory {
    id           String   @id @default(uuid())
    createdAt    DateTime @default(now())
    content      String
    database     String
    connectionId String
    userId       String
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, connectionId, database])
}

model DbConnection {
    id                            String  @id @default(uuid())
    name                          String
    allowDiskUse                  Boolean @default(true)
    connectionString              String
    tls                           Boolean @default(false)
    tlsAllowInvalidCertificates   Boolean @default(false)
    tlsCAFile                     String
    tlsCertificateKeyFile         String
    tlsCertificateKeyFilePassword String
    maxPoolSize                   Int     @default(4)
    whitelist                     String
    blacklist                     String
    userId                        String
    user                          User    @relation(name: "DbConnectionToUser", fields: [userId], references: [id])
}

// Every query run from the query editors, the newest ones per connection are kept
model QueryHistory {
    id           String   @id @default(uuid())
    createdAt    DateTime @default(now())
    sql          String
    database     String
    success      Boolean
    error        String?
    rowCount     Int?
    durationMs   Int?
    connectionId String
    userId       String
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, connectionId, createdAt])
}

model SavedQuery {
    id           String   @id @default(uuid())
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    name         String
    sql          String
    // The database it was saved from, it can be loaded into any editor
    database     String
    connectionId String
    userId       String
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, connectionId])
}
