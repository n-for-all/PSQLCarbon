<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build, App Sandbox. scripts/mas-entitlements.mjs fills in the team ID -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Connecting to databases and AI servers -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Saving backups and exports, opening backups to restore -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <!-- Electron's helper processes talk to each other through this group -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>TEAM_ID.APP_ID</string>
    </array>
</dict>
</plist>
